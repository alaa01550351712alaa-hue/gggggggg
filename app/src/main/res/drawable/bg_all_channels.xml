<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#A80F1A" android:endColor="#7F0A12"/>
            <corners android:radius="14dp"/>
            <stroke android:width="1dp" android:color="#E6444E"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#D8202A" android:centerColor="#C71722" android:endColor="#AF101A"/>
            <corners android:radius="14dp"/>
            <stroke android:width="1dp" android:color="#E64A52"/>
        </shape>
    </item>
</selector>

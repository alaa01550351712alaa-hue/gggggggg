<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:angle="315" android:startColor="#2B261A" android:centerColor="#1A1A1C" android:endColor="#101012"/>
            <corners android:radius="20dp"/>
            <stroke android:width="1.5dp" android:color="#C89A3D"/>
            <padding android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="315" android:startColor="#202124" android:centerColor="#171719" android:endColor="#0F1012"/>
            <corners android:radius="20dp"/>
            <stroke android:width="1dp" android:color="#6E5626"/>
            <padding android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp"/>
        </shape>
    </item>
</selector>
